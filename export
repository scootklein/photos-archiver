#!/bin/bash

set -euo pipefail

# Minimum osxphotos version required. Older versions can hit
# "no such table: Z_nnASSETS" against newer Photos library schemas.
MIN_OSXPHOTOS_VERSION="0.76.1"

# Get current username
USERNAME=$(whoami)

# S3 destination for this computer's archives
S3_PREFIX="s3://io.klein.backup/${USERNAME}-iphoto/"

# Verify osxphotos meets the minimum required version
check_osxphotos_version() {
    local version
    version=$(osxphotos --version 2>&1 | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || true)

    if [ -z "$version" ]; then
        echo "ERROR: Could not determine osxphotos version. Is it installed?" >&2
        exit 1
    fi

    local oldest
    oldest=$(printf '%s\n%s\n' "$MIN_OSXPHOTOS_VERSION" "$version" | sort -V | head -1)

    if [ "$oldest" != "$MIN_OSXPHOTOS_VERSION" ]; then
        echo "ERROR: osxphotos $version is older than the required $MIN_OSXPHOTOS_VERSION." >&2
        echo "Run: uv tool upgrade osxphotos" >&2
        exit 1
    fi
}

check_osxphotos_version

# Advance a YYYY-MM string by one month
next_month() {
    local year_month=$1
    date -v1d -v"${year_month%-*}y" -v"$((10#${year_month#*-}))m" -v+1m +%Y-%m
}

# Last calendar month that has fully elapsed
previous_month() {
    date -v1d -v-1m +%Y-%m
}

# Most recent YYYY-MM already archived to S3, empty if there are none
latest_archived_month() {
    aws s3 ls "$S3_PREFIX" \
        | awk '{print $4}' \
        | grep -oE '^[0-9]{4}-[0-9]{2}\.zip$' \
        | sed 's/\.zip$//' \
        | sort \
        | tail -1
}

# Every month strictly after $1 up to and including $2
months_after_through() {
    local current
    current=$(next_month "$1")

    while [[ "$current" < "$2" || "$current" == "$2" ]]; do
        echo "$current"
        current=$(next_month "$current")
    done
}

# Function to export a single month
export_month() {
    local year_month=$1

    # Parse YYYY-MM format
    local year="${year_month%-*}"
    local month="${year_month#*-}"

    # Remove leading zeros for calculations
    month=$((10#$month))

    # Format month with leading zero
    local month_padded=$(printf "%02d" $month)

    # osxphotos --to-date is exclusive, so bound the range with the first day of
    # the next month; using the last day of this month drops that day's photos.
    local from_date="${year}-${month_padded}-01"
    local to_date
    to_date="$(next_month "${year}-${month_padded}")-01"

    # Create export directory name
    local export_dir="$HOME/Downloads/${USERNAME}-iphoto-${year}-${month_padded}"
    local zip_filename="${year}-${month_padded}.zip"

    echo "========================================"
    echo "Exporting photos from: $from_date up to (excluding): $to_date"
    echo "Export directory: $export_dir"
    echo "========================================"

    # Create export directory if it doesn't exist
    mkdir -p "$export_dir"

    # Export photos for the month
    osxphotos export "$export_dir" \
        --export-by-date \
        --download-missing \
        --retry 3 \
        --touch-file \
        --from-date "$from_date" \
        --to-date "$to_date"

    echo "Export complete. Creating zip archive..."

    # Create zip file (cd to Downloads to avoid including full path in zip)
    cd "$HOME/Downloads"
    zip -r "$zip_filename" "${USERNAME}-iphoto-${year}-${month_padded}"

    echo "Zip archive created: $HOME/Downloads/$zip_filename"

    # Upload to S3
    echo "Uploading to S3..."
    aws s3 cp "$HOME/Downloads/$zip_filename" "$S3_PREFIX" --storage-class DEEP_ARCHIVE

    echo "Upload complete!"
    echo "Cleaning up local files..."

    # Clean up
    rm -rf "$export_dir"
    rm "$HOME/Downloads/$zip_filename"

    echo "Done! Exported and uploaded photos for ${year}-${month_padded}"
}

# Main script logic
if [ $# -eq 0 ]; then
    # No arguments provided - resume from the newest archive already in S3 and
    # catch up through the last fully elapsed month. Gaps older than that newest
    # archive are left alone; pass them explicitly if you want them re-exported.
    through_month=$(previous_month)
    latest=$(latest_archived_month)

    if [ -z "$latest" ]; then
        echo "No existing archives found in $S3_PREFIX"
        echo "Exporting $through_month only. Pass months explicitly to backfill further."
        export_month "$through_month"
    else
        echo "Most recent archive in S3: $latest"
        echo "Catching up through: $through_month"

        missing=$(months_after_through "$latest" "$through_month")

        if [ -z "$missing" ]; then
            echo "Already up to date. Nothing to export."
            exit 0
        fi

        echo "Months to export: $(echo "$missing" | tr '\n' ' ')"

        for year_month in $missing; do
            export_month "$year_month"
        done
    fi
else
    # Process each month/year pair provided
    for year_month in "$@"; do
        export_month "$year_month"
    done
fi

echo "========================================"
echo "All exports complete!"
echo "========================================"
